    "scan_in:SPI1_SCSN scan_out:GPIO3"
    "scan_in:SPI1_SDO scan_out:GPIO4"
    "scan_in:SPI1_SDI scan_out:GPIO5"
    "scan_in:SPI2_SCLK scan_out:GPIO6"
