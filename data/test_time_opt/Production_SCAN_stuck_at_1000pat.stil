Pattern scan_test  {
  //Pattern:0  Vector:0  TesterCycle:0
  Ann {* Pattern:0  Vector:0  TesterCycle:0 *}
  Ann {* "cycle_number:0 pattern_numer:0 pattern_type:basic" *}
  W tset_gen_tp1;
  Ann {*
    "scan_in:ETH_TXCLK scan_out:ETH_RXD3"
    "scan_in:ETH_TXD0 scan_out:ETH_RXCTL"
    "scan_in:ETH_TXD1 scan_out:ETH_MDIO"
