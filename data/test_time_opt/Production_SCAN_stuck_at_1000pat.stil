  Ann {* "cycle_number:1 vector_type:TEST_SETUP" *}
  V {  _bidi_=X1XX00XX000000X \r10 0  \r64 X 0100XX0000000 \r99 X ;
       _pi_=01100000;
       _po_=X;
  }
  Ann {* "cycle_number:2 vector_type:TEST_SETUP" *}
  V {  _bidi_=X0XX00XX000000X \r10 0  \r64 X 0100XX0000000 \r99 X ;
       _pi_=01100000;
  }
  Ann {* "cycle_number:3 vector_type:TEST_SETUP" *}
  V {  _bidi_=X1XX00XX000000X \r10 0  \r64 X 0100XX0000000 \r99 X ;
       _pi_=01100000;
  }
  Ann {* "cycle_number:4 vector_type:TEST_SETUP" *}
  V {
  }
  Ann {* + TAP controller reset *}
  Ann {* "cycle_number:5 vector_type:TEST_SETUP" *}
  V {  _bidi_=X00X01XX000000X \r10 0  \r64 X 0100XX0000000 \r99 X ;
       _pi_=01100000;
  }
  Ann {* + Advance TAP controller to idle *}
  Ann {* "cycle_number:6 vector_type:TEST_SETUP" *}
  V {  _bidi_=X10X01XX000000X \r10 0  \r64 X 0100XX0000000 \r99 X ;
       _pi_=01100000;
  }
  Ann {*  iCall init *}
  Loop 2 {
    Ann {* "cycle_number:7 vector_type:TEST_SETUP" *}
    V {  _bidi_=X10X01XX000000X \r10 0  \r64 X 0100XX0000000 \r99 X ;
         _pi_=01100000;
    }
  }  // end loop
  Ann {*  finished init sequence *}
  Ann {* + Targets: *}
  Ann {* +   Apply 0 *}
  Ann {* +     reads: *}
  Ann {* +        tap_tap_dft_MY_TOP_mbist_tessent_tap_main_inst.instruction[3:0]  =  0001 *}
  Ann {* +     writes: *}
  Ann {* +        tap_tap_dft_MY_TOP_mbist_tessent_tap_main_inst.instruction[3:0]  =  0111 *}
  Ann {* + TAP vector TDI..TDO ( *}
  Ann {* +        W 3:0    R 3:0   tap_tap_dft_MY_TOP_mbist_tessent_tap_main_inst.instruction[3:0] *}
  Ann {* + ) *}
  Ann {* +  Loading: 0111 *}
  Ann {* + Unloading: 0001 *}
