  Ann {* "cycle_number:0 vector_type:PRIMARY" *}
  V {  _bidi_=X1XX00XX000000X \r10 0  \r64 X 0100XX0000000 \r99 X ;
       _pi_=01100000;
       _po_=X;
  }
  //Pattern:0  Vector:1  TesterCycle:1
  Ann {* Pattern:0  Vector:1  TesterCycle:1 *}
  Ann {* "cycle_number:1 pattern_numer:0 pattern_type:basic" *}
  Ann {* PLL Capture cycles: procedure = ext_capture_7 *}
  Ann {* Begin Core pattern files used *}
  Ann {*    Begin Core:MY_DES  Mode:edt_int_slow *}
  Ann {*       PatternFileName: /proj/gw6p5/users/sbanoth/GW6/VFE/PD_Netlist_TIMING/20250826/ATPG/STK/tsdb_outdir/logic_test_cores/MY_DES_wo_reset_edt_slow.logic_test_core/MY_DES.atpg_mode_edt_int_slow/MY_DES_edt_int_slow_stuck.patdb *}
  Ann {*    End *}
